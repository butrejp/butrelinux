#!/usr/bin/env bash

# this is only tested against podman-backed installations.  it probably works elsewhere too though

set -Eeuo pipefail
IFS=$'\n\t'

readonly CONTAINER_NAME="extras"
readonly IMAGE="ghcr.io/butrejp/butrelinux-extras:latest"
readonly IMAGE_INFO="/usr/share/ublue-os/image-info.json"

while true; do
    read -r -p "This feature is currently in beta, would you like to continue? (y/n): " yn

    case "$yn" in
        [Yy])
            echo "Setting up butrelinux extras"
            break
            ;;
        [Nn])
            echo "Operation canceled by user"
            exit 0
            ;;
        *)
            echo "Invalid response. Please enter y or n"
            ;;
    esac
done

distrobox_args=(
    create
    --name "$CONTAINER_NAME"
    --image "$IMAGE"
    --yes
    --no-entry
)

if [[ -r "$IMAGE_INFO" ]] &&
   jq -e -r '.["image-name"] // empty | test("nvidia"; "i")' \
      "$IMAGE_INFO" >/dev/null; then
    distrobox_args+=(--nvidia)
fi

distrobox "${distrobox_args[@]}"

# shellcheck disable=SC2016
distrobox enter "$CONTAINER_NAME" --no-tty -- bash -c '
    set -Eeuo pipefail
    shopt -s nullglob

    for app in /usr/share/applications/*.desktop "$HOME"/.local/share/applications/*.desktop; do
        [[ -e "$app" ]] || continue
        distrobox-export --app "$app"
    done
'
distrobox enter "$CONTAINER_NAME" --no-tty -- sudo ln -sf /usr/bin/distrobox-host-exec /usr/local/bin/xdg-open
distrobox enter "$CONTAINER_NAME" --no-tty -- sudo ln -sf /usr/bin/distrobox-host-exec /usr/local/bin/flatpak

distrobox enter "$CONTAINER_NAME" --no-tty -- sudo sh -c 'cat >> /etc/profile.d/cnfhandle.sh' <<'EOF'
command_not_found_handle() {
  # don't run if not in a container
  if [ ! -e /run/.containerenv ] && [ ! -e /.dockerenv ]; then
    exit 127
  fi

  distrobox-host-exec "${@}"
}

if [ -n "${ZSH_VERSION-}" ]; then
  command_not_found_handler() {
    command_not_found_handle "$@"
  }
fi
EOF
