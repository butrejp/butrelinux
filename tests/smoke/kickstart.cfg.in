# butrelinux CI smoke-test kickstart
#
# THIS IS NOT A USER INSTALLATION KICKSTART.
#
# The production kickstart is intentionally minimal so that users must
# make their own installation decisions. This file exists only to
# exercise the unattended installer path in CI.

text
lang en_US.UTF-8
keyboard us
timezone UTC --utc

network --bootproto=dhcp --device=link --activate --hostname butrelinux-smoke

clearpart --all --initlabel --disklabel=gpt
autopart --type=lvm --noswap

# bootc/ostreecontainer requires bootloader --append when bootloader
# configuration is supplied in the kickstart.
bootloader --append="console=tty0 console=ttyS0"

rootpw --lock
user --name=smoke --groups=wheel --plaintext --password=smoke

ostreecontainer --url=ghcr.io/butrejp/butrelinux-@IMAGE@:latest

%post --erroronfail

set -eux

# Match the production kickstart's post-install bootc switch. This also
# verifies that the image's installed signature policy accepts the image.
bootc switch \
    --mutate-in-place \
    --enforce-container-sigpolicy \
    ghcr.io/butrejp/butrelinux-@IMAGE@:latest

# Match the production installer behavior.
systemctl mask kdump.service || true

if command -v grubby > /dev/null; then
    grubby --update-kernel=ALL --remove-args="crashkernel" || true
fi

sed -i 's/crashkernel=[^ ]*//g' /etc/default/grub || true

groupadd -f plugdev

# The smoke test deliberately enables SDDM autologin. This is test-only
# configuration and is never present in the production image.
mkdir -p /etc/sddm.conf.d

cat > /etc/sddm.conf.d/99-butrelinux-smoke.conf <<'EOF'
[Autologin]
User=smoke
Session=plasmawayland.desktop
Relogin=false
EOF

# The installed image must report its boot to the serial console.
# bootloader --append above handles this for the initial installation,
# while this makes the requirement explicit for bootc-managed kernels.
if command -v grubby > /dev/null; then
    grubby --update-kernel=ALL --args="console=tty0 console=ttyS0" || true
fi

mkdir -p /var/lib/butrelinux-smoke
chown smoke:smoke /var/lib/butrelinux-smoke

cat > /etc/butrelinux-smoke-user-check.sh <<'EOF'
#!/usr/bin/env bash

set -u

RESULT_DIR=/var/lib/butrelinux-smoke
RESULT_FILE="${RESULT_DIR}/result"
LOG_FILE="${RESULT_DIR}/user-check.log"

mkdir -p "$RESULT_DIR"
exec > >(tee -a "$LOG_FILE") 2>&1

failures=0

pass() {
    echo "PASS: $*"
}

fail() {
    echo "FAIL: $*"
    failures=$((failures + 1))
}

check_command() {
    local name="$1"
    local command="$2"

    if command -v "$command" >/dev/null 2>&1; then
        pass "$name"
    else
        fail "$name"
    fi
}

echo "== butrelinux desktop smoke test =="

echo
echo "== Environment =="

echo "USER=${USER:-}"
echo "XDG_CURRENT_DESKTOP=${XDG_CURRENT_DESKTOP:-}"
echo "XDG_SESSION_DESKTOP=${XDG_SESSION_DESKTOP:-}"
echo "XDG_SESSION_TYPE=${XDG_SESSION_TYPE:-}"

echo
echo "== Desktop session =="

if [[ "${XDG_CURRENT_DESKTOP:-}" == *KDE* ]]; then
    pass "XDG_CURRENT_DESKTOP contains KDE"
else
    fail "XDG_CURRENT_DESKTOP contains KDE"
fi

if [[ "${XDG_SESSION_TYPE:-}" == "wayland" ]]; then
    pass "session type is Wayland"
else
    fail "session type is Wayland"
fi

if pgrep -x plasmashell >/dev/null 2>&1; then
    pass "plasmashell is running"
else
    fail "plasmashell is running"
fi

if pgrep -x kwin_wayland >/dev/null 2>&1; then
    pass "kwin_wayland is running"
else
    fail "kwin_wayland is running"
fi

echo
echo "== Applications =="

check_command "Dolphin is installed" dolphin
check_command "Konsole is installed" konsole
check_command "Firefox is installed" firefox
check_command "Kate is installed" kate
check_command "Discover is installed" plasma-discover

echo
echo "== butrelinux tooling =="

check_command "bootc is installed" bootc
check_command "givemethekeys is installed" givemethekeys

if bootc status >/dev/null 2>&1; then
    pass "bootc status succeeds"
else
    fail "bootc status succeeds"
fi

if givemethekeys status >/dev/null 2>&1; then
    pass "givemethekeys status succeeds"
else
    fail "givemethekeys status succeeds"
fi

echo
echo "== User filesystem =="

TEST_DIR="${HOME}/butrelinux-smoke"

if mkdir -p "$TEST_DIR"; then
    echo "butrelinux smoke test" > "${TEST_DIR}/test.txt"

    if grep -qx 'butrelinux smoke test' "${TEST_DIR}/test.txt"; then
        pass "home directory is writable"
    else
        fail "home directory is writable"
    fi

    rm -rf "$TEST_DIR"
else
    fail "home directory is writable"
fi

echo
echo "== Result =="

if (( failures == 0 )); then
    echo "PASS" > "$RESULT_FILE"
    echo "DESKTOP_SMOKE_PASS"
else
    echo "FAIL" > "$RESULT_FILE"
    echo "DESKTOP_SMOKE_FAIL failures=${failures}"
fi

exit "$failures"
EOF

chmod 0755 /etc/butrelinux-smoke-user-check.sh

cat > /etc/systemd/system/butrelinux-smoke-finish.service <<'EOF'
[Unit]
Description=butrelinux CI smoke-test result collector
After=graphical.target
Wants=graphical.target
ConditionPathExists=/etc/butrelinux-ci-smoke

[Service]
Type=oneshot
ExecStart=/etc/butrelinux-smoke-finish.sh
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
EOF

cat > /etc/butrelinux-smoke-finish.sh <<'EOF'
#!/usr/bin/env bash

set -u

RESULT_DIR=/var/lib/butrelinux-smoke
RESULT_FILE="${RESULT_DIR}/result"
USER_LOG="${RESULT_DIR}/user-check.log"

mkdir -p "$RESULT_DIR"

# Give SDDM/Plasma plenty of time to establish the user's session.
for _ in $(seq 1 180); do
    if [[ -f "$RESULT_FILE" ]]; then
        break
    fi

    sleep 1
done

echo
echo "===== BUTRELINUX SMOKE RESULT ====="

if [[ -f "$USER_LOG" ]]; then
    cat "$USER_LOG"
fi

echo
echo "===== SYSTEM INFORMATION ====="

bootc status || true
systemctl is-system-running || true
systemctl is-active sddm.service || true

echo
echo "===== FAILED SERVICES ====="

systemctl --failed --no-legend || true

echo
echo "===== SMOKE RESULT ====="

if [[ -f "$RESULT_FILE" ]] && [[ "$(cat "$RESULT_FILE")" == "PASS" ]]; then
    echo "BUTRELINUX_SMOKE_PASS" > /dev/ttyS0 || true
    echo "BUTRELINUX_SMOKE_PASS"
    systemctl poweroff
    exit 0
fi

echo "BUTRELINUX_SMOKE_FAIL" > /dev/ttyS0 || true
echo "BUTRELINUX_SMOKE_FAIL"

# Leave the machine running long enough for the CI harness to collect
# the failure output, then power it off.
sleep 10
systemctl poweroff
exit 1
EOF

chmod 0755 /etc/butrelinux-smoke-finish.sh

ln -sf \
    /etc/systemd/system/butrelinux-smoke-finish.service \
    /etc/systemd/system/multi-user.target.wants/butrelinux-smoke-finish.service

touch /etc/butrelinux-ci-smoke

%end

reboot